# Copiá este archivo a ".env" y completá con los datos de TU proyecto de Firebase
# (Firebase console → ⚙️ Configuración del proyecto → tus apps → SDK setup and configuration)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Un "código de familia" simple, inventalo vos (ej: "familia-perez-2026")
# Todos los que usen el mismo código comparten los mismos datos.
VITE_FAMILY_CODE=mi-familia
